{
  "id": "deployment-query-regression",
  "category": "code-change",
  "executionModes": ["model-eval"],
  "alarm": {
    "name": "HealthcareApi-P99Latency",
    "metric": "TargetResponseTime",
    "stateReason": "p99 latency increased immediately after a deployment"
  },
  "observations": [
    {
      "id": "deployment-correlation",
      "source": "cloudtrail",
      "summary": "The latency increase began within two minutes of a new task definition deployment."
    },
    {
      "id": "query-volume-spike",
      "source": "cloudwatch",
      "summary": "Database query volume per request increased by more than an order of magnitude."
    },
    {
      "id": "repository-diff",
      "source": "github",
      "summary": "The deployment introduced per-sensor history lookups inside a response loop."
    }
  ],
  "expectation": {
    "requireConfirmedRootCause": true,
    "requireExecutableRemediation": true,
    "acceptedRootFaultTypes": ["slow-query"],
    "requiredRootCauseEvidenceIds": [
      "deployment-correlation",
      "query-volume-spike",
      "repository-diff"
    ],
    "requiredEvidenceIds": [
      "deployment-correlation",
      "query-volume-spike",
      "repository-diff"
    ],
    "requiredArtifacts": [
      "scoping",
      "hypotheses",
      "validation",
      "report",
      "playbook"
    ]
  }
}
