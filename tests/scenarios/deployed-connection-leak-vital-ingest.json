{
  "id": "deployed-connection-leak-vital-ingest",
  "category": "database",
  "executionModes": ["model-eval", "deployed-e2e"],
  "alarm": {
    "name": "RcaAgentDev-Healthcare-VitalIngestFailures",
    "metric": "VitalIngestFailures",
    "stateReason": "Patient vital readings failed to be recorded for two consecutive minutes"
  },
  "observations": [
    {
      "id": "vital-ingest-failures",
      "source": "cloudwatch",
      "summary": "VitalIngestFailures rose from zero while VitalIngestAttempts stayed flat, so recording is failing rather than demand growing."
    },
    {
      "id": "db-connections-climbing",
      "source": "cloudwatch",
      "summary": "RDS DatabaseConnections increased steadily from the deployment onward instead of holding a steady level."
    },
    {
      "id": "session-not-returned-logs",
      "source": "logs",
      "summary": "Repeated 'DB session not returned to the pool' warnings with a rising checked-out connection count."
    },
    {
      "id": "task-definition-deployment",
      "source": "cloudtrail",
      "summary": "RegisterTaskDefinition and UpdateService on the Healthcare service immediately precede the first ingest failure."
    },
    {
      "id": "fault-flag-enabled-in-revision",
      "source": "cloudtrail",
      "summary": "The deployed task definition revision enables the FAULT_DB_LEAK environment flag, which the previous revision had disabled."
    },
    {
      "id": "leaky-session-read-path",
      "source": "github",
      "summary": "The patient vitals read path acquires a session that is never closed when the leak flag is enabled."
    },
    {
      "id": "request-volume-flat",
      "source": "cloudwatch",
      "summary": "Sensor ingest attempt volume stayed at its normal level throughout, so a traffic surge did not drive the failures."
    },
    {
      "id": "rds-resources-healthy",
      "source": "cloudwatch",
      "summary": "RDS CPUUtilization and FreeStorageSpace remained within normal range, so the instance itself was not saturated."
    },
    {
      "id": "unrelated-log-level-deployment",
      "source": "cloudtrail",
      "summary": "A second deployment only changed the LOG_LEVEL setting and does not line up with the onset of failures."
    }
  ],
  "expectation": {
