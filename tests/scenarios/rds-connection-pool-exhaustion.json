{
  "id": "rds-connection-pool-exhaustion",
  "category": "database",
  "executionModes": ["model-eval"],
  "alarm": {
    "name": "HealthcareApi-Http5xx",
    "metric": "HTTPCode_Target_5XX_Count",
    "stateReason": "5xx responses exceeded the threshold for five minutes"
  },
  "observations": [
    {
      "id": "db-connections-maxed",
      "source": "cloudwatch",
      "summary": "DatabaseConnections remained at the configured maximum."
    },
    {
      "id": "pool-timeout-logs",
      "source": "logs",
      "summary": "Requests failed while waiting for a connection from the application pool."
    },
    {
      "id": "request-concurrency-over-pool-capacity",
      "source": "cloudwatch",
      "summary": "Request concurrency exceeded the configured application pool capacity while database CPU and storage remained healthy."
    }
  ],
  "expectation": {
    "requireConfirmedRootCause": true,
    "rootCauseTermGroups": [
      ["connection pool", "database pool", "커넥션 풀", "연결 풀"],
      ["exhausted", "saturated", "maximum", "고갈", "포화", "최대", "상한"]
    ],
    "requiredEvidenceIds": [
      "db-connections-maxed",
      "pool-timeout-logs",
      "request-concurrency-over-pool-capacity"
    ],
    "requiredArtifacts": [
      "scoping",
      "hypotheses",
      "validation",
      "report",
      "playbook"
    ],
    "remediationTermGroups": [
      ["pool", "connection", "풀", "커넥션", "연결"],
      [
        "limit",
        "timeout",
        "capacity",
        "제한",
        "한도",
        "타임아웃",
        "용량",
        "상한"
      ]
    ],
    "semanticTermGroups": [
      ["traffic", "requests", "트래픽", "요청"],
      [
        "bounded",
        "database capacity",
        "pool capacity",
        "max_size",
        "max_connections",
        "제한",
        "한도",
        "상한",
        "데이터베이스 용량",
        "풀 용량",
        "설정 용량"
      ]
    ]
  }
}
