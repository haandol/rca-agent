    raise\"},{\"line\":20,\"text\":\"@asynccontextmanager\"},{\"line\":21,\"text\":\"async def session_scope(factory, owned: set[AsyncSession]) -> AsyncIterator[AsyncSession]:\"},{\"line\":23,\"text\":\"    session = factory()\"},{\"line\":24,\"text\":\"    owned.add(session)\"},{\"line\":25,\"text\":\"    try:\"},{\"line\":26,\"text\":\"        yield session\"},{\"line\":27,\"text\":\"        await session.commit()\"},{\"line\":28,\"text\":\"    finally:\"},{\"line\":30,\"text\":\"        await close_session(session)\"},{\"line\":31,\"text\":\"        owned.discard(session)\"}]}},{\"context\":\"incident\",\"window\":{\"start\":\"2026-09-10T02:53:49.259759+00:00\",\"end\":\"2026-09-10T02:53:49.620350+00:00\"},\"source\":{\"path\":\"packages/healthcare-sensor-app/demo/revisions/r3/session.py\",\"sha256\":\"823400d86ff5ffe2fa715ed8827fa31b80fe48de2080ad3dbd2274bf3544ac18\",\"lines\":[{\"line\":3,\"text\":\"import asyncio\"},{\"line\":4,\"text\":\"from collections.abc import AsyncIterator\"},{\"line\":5,\"text\":\"from contextlib import asynccontextmanager\"},{\"line\":7,\"text\":\"from sqlalchemy.ext.asyncio import AsyncSession\"},{\"line\":10,\"text\":\"async def close_session(session: AsyncSession) -> None:\"},{\"line\":12,\"text\":\"    cleanup = asyncio.create_task(session.close())\"},{\"line\":13,\"text\":\"    try:\"},{\"line\":14,\"text\":\"        await asyncio.shield(cleanup)\"},{\"line\":15,\"text\":\"    except asyncio.CancelledError:\"},{\"line\":16,\"text\":\"        await cleanup\"},{\"line\":17,\"text\":\"        raise\"},{\"line\":20,\"text\":\"@asynccontextmanager\"},{\"line\":21,\"text\":\"async def session_scope(factory, owned: set[AsyncSession]) -> AsyncIterator[AsyncSession]:\"},{\"line\":23,\"text\":\"    session = factory()\"},{\"line\":24,\"text\":\"    owned.add(session)\"},{\"line\":25,\"text\":\"    try:\"},{\"line\":28,\"text\":\"        await session.connection()\"},{\"line\":29,\"text\":\"    except BaseException:\"},{\"line\":30,\"text\":\"        await close_session(session)\"},{\"line\":31,\"text\":\"        owned.discard(session)\"},{\"line\":32,\"text\":\"        raise\"},{\"line\":33,\"text\":\"    yield session\"},{\"line\":34,\"text\":\"    await session.commit()\"},{\"line\":36,\"text\":\"    await close_session(session)\"},{\"line\":37,\"text\":\"    owned.discard(session)\"}]}}]}"
