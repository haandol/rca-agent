{
  "description": "Format Codex patches and run the repository verification before pushes.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/hooks/format-file.sh\"",
            "timeout": 60,
            "statusMessage": "Formatting patched files"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/hooks/verify-before-push.sh\"",
            "timeout": 900,
            "statusMessage": "Verifying before push"
          }
        ]
      }
    ]
  }
}
