{
  "enabledPlugins": {
    "alps-writer@alps-writer": true
  },
  "extraKnownMarketplaces": {},
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/hooks/format-file.sh\"",
            "timeout": 60,
            "statusMessage": "Formatting"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/hooks/verify-before-push.sh\"",
            "timeout": 900,
            "statusMessage": "Verifying before push"
          }
        ]
      }
    ]
  }
}
