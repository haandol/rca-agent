{
  "mcpServers": {
    "aws-knowledge": {
      "command": "fastmcp",
      "args": ["run", "https://knowledge-mcp.global.api.aws"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "cloudwatch": {
      "command": "uvx",
      "args": ["awslabs.cloudwatch-mcp-server"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "cloudtrail": {
      "command": "uvx",
      "args": ["awslabs.cloudtrail-mcp-server"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "github": {
      "command": "github-mcp-server",
      "args": ["stdio"],
      "env": {
        "GITHUB_READ_ONLY": "1",
        "GITHUB_TOOLSETS": "repos,pull_requests"
      }
    },
    "rca-progress": {
      "command": "fastmcp",
      "args": [
        "run",
        "/app/src/cc_headless/mcp_server.py:mcp"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    }
  }
}
